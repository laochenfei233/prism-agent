{
  // The bundle is out of tree, so it borrows the checkout's packages instead of
  // declaring workspace dependencies: the `@deepseek-ai/*` imports in src/ are
  // `import type` except `createUserMessage`, which the verification gate needs
  // as a value to steer the agent at its stopping boundary, and the filesystem
  // skill provider's `apply`, which the skills entry calls.
  //
  // These `paths` entries replace the base map (an extending config does not
  // merge `paths`) and point at the checkout's BUILT declarations, which is
  // how the repository's own packages consume each other through project
  // references. Everything those declarations import resolves through the
  // checkout's node_modules. Run `pnpm run build` in the checkout first.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "paths": {
      "@deepseek-ai/cordis": ["../../vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-agent": ["../../packages/core/agent/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-agent-preset-registry/types": ["../../packages/preset/agent-preset-registry/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-commands": ["../../packages/interaction/commands/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-commands/brand": ["../../packages/interaction/commands/lib/types/brand.d.ts"],
      "@deepseek-ai/dsh-llm": ["../../packages/llm/llm/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-plan-mode": ["../../packages/plan/plan-mode/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-skill": ["../../packages/skill/skill/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-system-prompt": ["../../packages/core/system-prompt/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-tools": ["../../packages/core/tools/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-tool-todo/types": ["../../packages/todo/tool-todo/lib/types/types.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
