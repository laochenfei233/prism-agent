{
  "name": "@prism-ai/prism-meeting",
  "description": "Prism meeting-minutes plugin: durable records, transcribed audio, configured summaries, persisted answers, model-facing tools, and the Web meeting page",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laochenfei233/prism-agent-e.git",
    "directory": "packages/prism/prism-meeting"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./web": {
      "types": "./lib/types/web.d.ts",
      "default": "./lib/types/web.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-brand": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-speech-to-text": "0.1.7-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.1",
    "@deepseek-ai/dsh-speech-to-text": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}