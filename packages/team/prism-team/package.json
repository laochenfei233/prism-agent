{
  "name": "@prism/prism-team",
  "version": "0.2.3+1",
  "private": true,
  "type": "module",
  "description": "Prism Team: structured teammate reports, a needs-a-person list, a private worktree per teammate, and an enforced task write scope for Agent Teams",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2"
  }
}
