{
  // The bundle is out of tree, so it borrows the checkout's packages instead of
  // declaring workspace dependencies: the `@deepseek-ai/*` imports in src/ are
  // `import type` except `defineTool` and `CommandDefinitionId`, which execute
  // and register at runtime.
  //
  // These `paths` entries replace the base map (an extending config does not
  // merge `paths`) and point at the checkout's BUILT declarations, which is how
  // the repository's own packages consume each other through project
  // references. Run `pnpm run build` in the checkout first.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "paths": {
      "@deepseek-ai/cordis": ["../../../vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-agent": ["../../../packages/core/agent/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-agent-team": ["../../../packages/team/agent-team/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-connection": ["../../../packages/client/connection/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-commands": ["../../../packages/interaction/commands/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-commands/brand": ["../../../packages/interaction/commands/lib/types/brand.d.ts"],
      "@deepseek-ai/dsh-session": ["../../../packages/core/session/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-subagent": ["../../../packages/subagent/subagent/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-system-prompt": ["../../../packages/core/system-prompt/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-tools": ["../../../packages/core/tools/lib/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/client"]
}
