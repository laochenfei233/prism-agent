{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism Agent",
  "mainBinaryName": "prism-agent",
  "version": "0.2.1-rc.4",
  "identifier": "ai.prism.agent.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "node --version"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Prism Agent",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src http://127.0.0.1:*; connect-src http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' http://127.0.0.1:* data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "windows": {
      "nsis": {
        "template": "./installer-template.nsi",
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "uninstallerHeaderImage": "icons/installer-header.bmp",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../runtime": "runtime"
    },
    "category": "DeveloperTool",
    "shortDescription": "Prism Agent desktop client",
    "longDescription": "A standalone desktop client for Prism Agent. Embeds the dsh web UI in a native window with a bundled Node runtime."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5ODdDRjUwNTQ4MDA5QUIKUldTckNZQlVVTStIT1NYUlF4RVl4OU9MUUluZ0pyc0VuOXBRMGVwbzJQVzVva1ZoL3VvWXhIM2oK",
      "endpoints": [
        "https://github.com/laochenfei233/prism-agent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
